# Paste these values from your Firebase project's "Web app" config
# (Project settings > Your apps > SDK setup and configuration) into the
# project's Keys/API keys tab. The app reads them at build time.

VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abc123...

# =============================================================================
# Backend keys (the till) — paste into the project's Keys/API keys tab
# =============================================================================
# The paid integrations run as HTTP actions inside this project's Convex
# deployment (src/convex/till.ts) — there is NO separate server to deploy.
# Keys pasted in the Keys tab arrive there as process.env (server-side only,
# never in the browser bundle):
#
#   STRIPE_SECRET_KEY      -> powers "The Premium Ledger" checkout. Grab a
#                             sandbox key (sk_test_...) at
#                             https://dashboard.stripe.com/apikeys — no
#                             signup wall. Flip to an sk_live_ key only when
#                             you're ready for real money.
#   GEMINI_API_KEY         -> powers "Ask the books" (free key at
#                             https://aistudio.google.com/app/apikey)
#   GRAVITY_API_KEY        -> contextual ads in the chat panel (trygravity.ai).
#                             Test ads by default; set GRAVITY_PRODUCTION=true
#                             only when you're ready for real, billed ads.
#
# The backend exposes (auto-detected by the client):
#   GET  /api/config            what's wired up
#   GET  /api/stats             usage tally
#   POST /api/assistant         Gemini answers, streamed as SSE
#   POST /api/ad                Gravity ad proxy
#   POST /api/stripe/checkout   create a hosted Checkout Session (premium)
#   POST /api/stripe/verify     confirm a returned session before granting
#
# The client finds the backend automatically: it uses the Convex site URL
# (explicit VITE_CONVEX_SITE_URL, or derived from the deployment's
# VITE_CONVEX_URL), then falls back to VITE_API_URL for a legacy server.

# =============================================================================
# Optional legacy server (main.ts) — only for setups that want it
# =============================================================================
# main.ts is a Deno/Hono server that serves the same /api/* endpoints. It can
# be deployed to Deno Deploy (entrypoint main.ts; deno.json maps the imports)
# and pointed to with VITE_API_URL below. Everything works without it.
# If you deploy it on a DIFFERENT domain than the app, set its origin here
# (otherwise same-origin /api/... is used):
VITE_API_URL=
#
# Braintree Drop-in (legacy, optional) — only relevant if you deploy main.ts:
#   BRAINTREE_MERCHANT_ID / BRAINTREE_PUBLIC_KEY / BRAINTREE_PRIVATE_KEY
#   BRAINTREE_ENVIRONMENT -> optional: sandbox (default) or production
#   BRAINTREE_CURRENCY    -> optional: default USD

# =============================================================================
# Client-side fallbacks (OPTIONAL — only needed in previews without the
# backend). Prefer the Keys-tab keys above.
# =============================================================================

# --- Optional browser-safe proxy configuration ---
# Provider credentials must remain server-side in Convex/legacy-server secrets.
# A proxy URL may be used only when it does not require a provider secret in
# the browser. The app otherwise disables the optional feature gracefully.
VITE_GRAVITY_FUNCTION_URL=

# --- Stripe tip jar ("Support the pot") ---
# A Stripe Payment Link (dashboard.stripe.com > Payment Links) — zero backend.
# Create one with "allow customer to set amount" for a proper tip jar.
VITE_STRIPE_PAYMENT_LINK=

# --- Braintree tip jar (legacy, optional) ---
# Client-side only: the URL of the server that hosts the Braintree endpoints.
# Leave blank to use VITE_API_URL when set, otherwise the same origin as the
# app. Set this only for a dedicated till server on its own domain.
VITE_BRAINTREE_FUNCTION_URL=

# The Braintree credentials themselves NEVER go in this file or the browser.
# Set them as environment variables on the server that runs main.ts:
#   BRAINTREE_MERCHANT_ID, BRAINTREE_PUBLIC_KEY, BRAINTREE_PRIVATE_KEY
# plus optional BRAINTREE_ENVIRONMENT (sandbox|production, default sandbox)
# and BRAINTREE_CURRENCY (default USD).
# Braintree sandbox test card: 4111 1111 1111 1111, any future expiry, any CVV.
