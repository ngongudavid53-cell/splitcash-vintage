# Paste these values from your Firebase project's "Web app" config
# (Project settings > Your apps > SDK setup and configuration) into the
# project's Keys/API keys tab. The app reads them at build time.

VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abc123...

# =============================================================================
# Backend keys (the till) — paste into the project's Keys/API keys tab
# =============================================================================
# Paid integrations run as HTTP actions inside this project's Convex
# deployment. Provider secrets stay server-side.
#
# Stripe:
#   STRIPE_SECRET_KEY=sk_test_... (use sk_live_ only for real payments)
#   PAYMENTS_ENABLED=false until the complete production payment flow is tested
#
# Gemini / Gravity:
#   GEMINI_API_KEY=...
#   GRAVITY_API_KEY=...
#
# Firebase Admin REST access for durable Premium entitlements:
#   FIREBASE_PROJECT_ID=your-project-id
#   FIREBASE_CLIENT_EMAIL=firebase-service-account@your-project-id.iam.gserviceaccount.com
#   FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n
# The service-account values above are backend secrets. NEVER prefix them with
# VITE_ and never commit them to the repository.
# The service account needs permission to read/write the Firestore database.

# The backend exposes:
#   GET  /api/config            what's wired up
#   GET  /api/stats             usage tally
#   POST /api/assistant         Gemini answers, streamed as SSE
#   POST /api/ad                Gravity ad proxy
#   POST /api/scan-receipt      receipt OCR
#   POST /api/stripe/checkout   create a hosted Checkout Session
#   POST /api/stripe/verify     confirm a returned paid session
#   POST /api/stripe/grant      durably grant Premium after server verification

# The client finds the backend automatically: it uses the Convex site URL
# (explicit VITE_CONVEX_SITE_URL, or derived from VITE_CONVEX_URL), then falls
# back to VITE_API_URL for a legacy server.

# =============================================================================
# Optional legacy server (main.ts) — only for setups that want it
# =============================================================================
VITE_API_URL=

# Braintree Drop-in (legacy, optional) — only relevant if you deploy main.ts:
#   BRAINTREE_MERCHANT_ID / BRAINTREE_PUBLIC_KEY / BRAINTREE_PRIVATE_KEY
#   BRAINTREE_ENVIRONMENT -> optional: sandbox (default) or production
#   BRAINTREE_CURRENCY    -> optional: default USD

# =============================================================================
# Client-side fallbacks (OPTIONAL — only needed in previews without backend)
# =============================================================================
VITE_GRAVITY_FUNCTION_URL=
VITE_STRIPE_PAYMENT_LINK=
VITE_BRAINTREE_FUNCTION_URL=
