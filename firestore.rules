rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function isMemberOf(groupId) {
      return signedIn() && groupDoc(groupId).data.memberIds.hasAny([request.auth.uid]);
    }

    // inviteCodes/{code} — the public index that turns a six-letter code into
    // a group id. Readable by any signed-in member (that's how joining works);
    // writing one requires being a member of the group it points at.
    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.groupId is string
        && request.resource.data.groupId.size() > 0
        && isMemberOf(request.resource.data.groupId);
      allow delete: if false;
    }

    // User profiles: clients may maintain only their own public identity.
    // Premium entitlement fields (premium, premiumTx, premiumSince) cannot be set
    // or updated by client Firestore writes under any circumstances.
    // Premium updates must be written via server context / Firebase Admin SDK.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && (!request.resource.data.keys().hasAny(["premium", "premiumTx", "premiumSince"])
            || request.resource.data.premium == false);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "email"]);
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn()
        && resource.data.memberIds.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6;

      // A non-member may join only as themselves. Group metadata is immutable
      // from the browser, preventing members from rewriting invite codes or
      // identities. Administrative edits need a trusted server path.
      allow update: if signedIn()
        && !resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["members", "memberIds"])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAny([request.auth.uid])
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members[request.resource.data.members.size() - 1].uid == request.auth.uid
        && request.resource.data.members[request.resource.data.members.size() - 1].name is string
        && request.resource.data.members[request.resource.data.members.size() - 1].name.size() > 0;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /expenses/{expenseId} {
        allow read: if signedIn() && isMemberOf(groupId);
        allow create: if signedIn() && isMemberOf(groupId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 200
          && request.resource.data.paidBy is string
          && groupDoc(groupId).data.memberIds.hasAny([request.resource.data.paidBy])
          && request.resource.data.splitBetween is list
          && request.resource.data.splitBetween.size() >= 1
          && request.resource.data.splitBetween.size() <= groupDoc(groupId).data.memberIds.size()
          && request.resource.data.splitBetween.hasOnly(groupDoc(groupId).data.memberIds)
          && request.resource.data.splitMode in ["equal", "custom"]
          && ((request.resource.data.splitMode == "equal" && request.resource.data.shares == null)
            || (request.resource.data.splitMode == "custom" && request.resource.data.shares is map));
        allow update: if signedIn() && isMemberOf(groupId)
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 200
          && request.resource.data.paidBy is string
          && groupDoc(groupId).data.memberIds.hasAny([request.resource.data.paidBy])
          && request.resource.data.splitBetween is list
          && request.resource.data.splitBetween.size() >= 1
          && request.resource.data.splitBetween.size() <= groupDoc(groupId).data.memberIds.size()
          && request.resource.data.splitBetween.hasOnly(groupDoc(groupId).data.memberIds)
          && request.resource.data.splitMode in ["equal", "custom"]
          && ((request.resource.data.splitMode == "equal" && request.resource.data.shares == null)
            || (request.resource.data.splitMode == "custom" && request.resource.data.shares is map));
        allow delete: if signedIn() && isMemberOf(groupId)
          && resource.data.createdBy == request.auth.uid;
      }

      match /settlements/{settlementId} {
        allow read: if signedIn() && isMemberOf(groupId);
        allow create: if signedIn() && isMemberOf(groupId)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.settledBy == request.auth.uid
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.to is string
          && request.resource.data.to != request.auth.uid
          && groupDoc(groupId).data.memberIds.hasAny([request.resource.data.to]);
        allow update: if false;
        allow delete: if signedIn() && isMemberOf(groupId)
          && resource.data.from == request.auth.uid;
      }
    }
  }
}
